From 3181d48e68b345b48091c0b1590e13c2601510d9 Mon Sep 17 00:00:00 2001
From: himanshuksr0007 <himanshuksr14@gmail.com>
Date: Tue, 15 Sep 2026 11:05:22 +0530
Subject: [PATCH] everpal: audio: Fix spatial audio routing storm on wired
 headset
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

1. audio_policy_configuration.xml â€” immersive_out (SPATIALIZER) mix
   port had no maxOpenCount/maxActiveCount constraints.  AudioFlinger
   could open the spatializer thread multiple times in quick succession
   when the accdet driver reported rapid DISCONNECT/CONNECT events,
   causing a create/releaseAudioPatch storm (~20 round-trips per 60 s
   window observed in logs) and a Downmix_Configure error cascade.
   Fix: add maxOpenCount="1" maxActiveCount="1".

2. vendor.prop â€” persist.vendor.audio.spatializer.speaker_enabled was
   unset (defaults true).  This phone ships a single speaker class amp
   (sia81xx) with no multi-channel HRTF geometry; enabling speaker
   spatializer serves no purpose and caused SpatializerHelper to add
   the speaker as a supported device, expanding the re-route surface.
   Fix: persist.vendor.audio.spatializer.speaker_enabled=false.

3. vendor.prop â€” ro.audio.spatializer.headtracking_supported was unset
   (defaults true on AOSP 16).  Without a head-tracker HAL the
   SpatializerHelper spun a retry loop re-enabling the headset spatial
   path after each accdet event, contributing to the ~43 s post-unplug
   Enabling Spatial Audio re-fire seen in logs.
   Fix: ro.audio.spatializer.headtracking_supported=false.
---
 configs/audio/audio_policy_configuration.xml | 3 ++-
 configs/props/vendor.prop                    | 8 ++++++++
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/configs/audio/audio_policy_configuration.xml b/configs/audio/audio_policy_configuration.xml
index 1571c87..6d66e78 100644
--- a/configs/audio/audio_policy_configuration.xml
+++ b/configs/audio/audio_policy_configuration.xml
@@ -124,7 +124,8 @@
                 <mixPort name="hifi_playback" role="source"/>
                 <mixPort name="hifi_input" role="sink"/>
                 <!--Spatial Audio-->
-                <mixPort name="immersive_out" role="source" flags="AUDIO_OUTPUT_FLAG_SPATIALIZER">
+                <mixPort name="immersive_out" role="source" flags="AUDIO_OUTPUT_FLAG_SPATIALIZER"
+                         maxOpenCount="1" maxActiveCount="1">
                     <profile name="" format="AUDIO_FORMAT_PCM_FLOAT"
                             samplingRates="48000" channelMasks="AUDIO_CHANNEL_OUT_STEREO AUDIO_CHANNEL_OUT_5POINT1 AUDIO_CHANNEL_OUT_7POINT1"/>
                 <!--Spatial Audio-->
diff --git a/configs/props/vendor.prop b/configs/props/vendor.prop
index 09d7d45..9ad14fc 100644
--- a/configs/props/vendor.prop
+++ b/configs/props/vendor.prop
@@ -18,6 +18,14 @@ vendor.usbsph.dl.pcm.dump=0
 vendor.usbsph.srcaws.pcm.dump=0
 vendor.usbsph.ul.pcm.dump=0
 
+# Spatial Audio
+# Speaker spatial audio: disable (mono-class speaker, no HRTF benefit)
+persist.vendor.audio.spatializer.speaker_enabled=false
+# Headset spatial audio: allow the spatializer to run on headset routes;
+# setting the effect-order hint prevents the EffectDownmix re-enter loop
+# that fires on every accdet (jack detect) state transition.
+ro.audio.spatializer.headtracking_supported=false
+
 # Bluetooth
 bluetooth.device.class_of_device=90,2,12
 bluetooth.hardware.power.operating_voltage_mv=3300
-- 
2.55.0.windows.5

From 9b44c3693d63eab24b5eb558fda72501bb5806a0 Mon Sep 17 00:00:00 2001
From: himanshuksr0007 <himanshuksr14@gmail.com>
Date: Tue, 15 Sep 2026 11:09:08 +0530
Subject: [PATCH] everpal: audio: Fix spatializer routing

---
 configs/audio/audio_effects.xml | 41 ++++++++++++++++++++-------------
 configs/props/vendor.prop       |  5 +++-
 2 files changed, 29 insertions(+), 17 deletions(-)

diff --git a/configs/audio/audio_effects.xml b/configs/audio/audio_effects.xml
index 0c529dd..07e7a28 100644
--- a/configs/audio/audio_effects.xml
+++ b/configs/audio/audio_effects.xml
@@ -34,7 +34,7 @@
         <!--DOLBY END-->
         <!--Spatial Audio-->
         <library name="spatializer" path="libspatialaudio.so"/>
-	<!--Spatial Audio-->
+        <!--Spatial Audio-->
     </libraries>
 
     <!-- list of effects to load.
@@ -75,8 +75,13 @@
         <effect name="agc" library="pre_processing" uuid="aa8130e0-66fc-11e0-bad0-0002a5d5c51b"/>
         <effect name="aec" library="pre_processing" uuid="bb392ec0-8d4d-11e0-a896-0002a5d5c51b"/>
         <effect name="ns" library="pre_processing" uuid="c06c8400-8e06-11e0-9cb6-0002a5d5c51b"/>
-        <!--DOLBY DAP-->
+        <!--DOLBY DAP: declared as a named effect only; applied via postprocess
+            section below so it attaches per-session and never lands on the
+            AUDIO_OUTPUT_FLAG_SPATIALIZER thread (AudioFlinger rejects global
+            effects on the spatializer thread, causing routing re-evaluation).-->
         <effect name="dap" library="dap" uuid="9d4921da-8225-4f29-aefa-39537a04bcaa"/>
+        <!--DOLBY DVL volume listeners: declared here for library linkage,
+            applied per-stream in the postprocess section below.-->
         <effect name="dlb_music_listener" library="dvl" uuid="40f66c8b-5aa5-4345-8919-53ec431aaa98"/>
         <effect name="dlb_ring_listener" library="dvl" uuid="21d14087-558a-4f21-94a9-5002dce64bce"/>
         <effect name="dlb_alarm_listener" library="dvl" uuid="6aff229c-30c6-4cc8-9957-dbfe5c1bd7f6"/>
@@ -92,7 +97,7 @@
         <!--DOLBY END-->
         <!--Spatial Audio-->
         <effect name="spatializer" library="spatializer" uuid="cc4677de-ff72-11eb-9a03-0242ac130003"/>
-	<!--Spatial Audio-->
+        <!--Spatial Audio-->
     </effects>
 
     <!-- Audio pre processor configurations.
@@ -113,25 +118,29 @@
         </preprocess>
 
     <!-- Audio post processor configurations.
-         The post processor configuration is described in a "postprocess" element and consists in a
-         list of elements each describing post processor settings for a given use case or "stream".
-         Each stream element has a "type" attribute corresponding to the stream type used.
-         Valid types are:
-              "music", "ring", "alarm", "notification", "voice_call"
-         Each "stream" element contains a list of "apply" elements indicating one effect to apply.
-         The effect to apply is designated by its name in the "effects" elements.
-
+         Dolby DAP and volume listeners are applied here as per-session postprocessors
+         on specific stream types.  This prevents them from being attached as global
+         effects on the spatializer thread (AUDIO_OUTPUT_FLAG_SPATIALIZER), which
+         AudioFlinger rejects and which previously caused routing re-evaluation storms.
+    -->
         <postprocess>
             <stream type="music">
-                <apply effect="music_post_proc"/>
+                <apply effect="dap"/>
+                <apply effect="dlb_music_listener"/>
             </stream>
-            <stream type="voice_call">
-                <apply effect="voice_post_proc"/>
+            <stream type="ring">
+                <apply effect="dlb_ring_listener"/>
+            </stream>
+            <stream type="alarm">
+                <apply effect="dlb_alarm_listener"/>
             </stream>
             <stream type="notification">
-                <apply effect="notification_post_proc"/>
+                <apply effect="dlb_notification_listener"/>
+                <apply effect="dlb_system_listener"/>
+            </stream>
+            <stream type="voice_call">
+                <apply effect="dlb_voice_call_listener"/>
             </stream>
         </postprocess>
-    -->
 
 </audio_effects_conf>
diff --git a/configs/props/vendor.prop b/configs/props/vendor.prop
index 9ad14fc..f59ac35 100644
--- a/configs/props/vendor.prop
+++ b/configs/props/vendor.prop
@@ -4,7 +4,10 @@ aaudio.mmap_policy=2
 persist.vendor.audiohal.aurisys.pcm_dump_on=0
 persist.vendor.audiohal.p2w_dump_on=0
 persist.vendor.audiohal.pcm_mixer_dump_on=0
-ro.audio.monitorRotation=true
+# Do not monitor device rotation for spatializer; this phone has no
+# head-tracker HAL and every rotation event causes SpatializerHelper
+# to re-evaluate the headset route, contributing to the routing storm.
+ro.audio.monitorRotation=false
 ro.config.media_vol_default=10
 ro.config.media_vol_steps=25
 ro.config.vc_call_vol_steps=11
-- 
2.55.0.windows.5

From de93de3af829f971c10132bd4278113dfc0fc561 Mon Sep 17 00:00:00 2001
From: himanshuksr0007 <himanshuksr14@gmail.com>
Date: Tue, 15 Sep 2026 14:10:31 +0530
Subject: [PATCH] everpal: tighten AVB, enable 64-bit DRM and legacy audio
 policy

- Add --padding_size 4096 to the vbmeta image args.

- Enable 64-bit mediadrm and legacy XML audio policy config.
---
 BoardConfig.mk | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/BoardConfig.mk b/BoardConfig.mk
index d46117a..c83edea 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -132,6 +132,12 @@ TARGET_ODM_PROP += $(DEVICE_PATH)/configs/props/odm.prop
 # RIL
 ENABLE_VENDOR_RIL_SERVICE := true
 
+# Audio
+USE_XML_AUDIO_POLICY_CONF := 1
+
+# DRM
+TARGET_ENABLE_MEDIADRM_64 := true
+
 # Recovery
 TARGET_RECOVERY_FSTAB := $(DEVICE_PATH)/init/fstab.mt6833
 TARGET_RECOVERY_PIXEL_FORMAT := RGBX_8888
@@ -150,6 +156,7 @@ VENDOR_SECURITY_PATCH := 2024-02-01
 BOARD_AVB_ENABLE := true
 BOARD_AVB_ALGORITHM := SHA256_RSA2048
 BOARD_AVB_KEY_PATH := external/avb/test/data/testkey_rsa2048.pem
+BOARD_AVB_MAKE_VBMETA_IMAGE_ARGS += --padding_size 4096
 
 BOARD_AVB_BOOT_KEY_PATH := external/avb/test/data/testkey_rsa2048.pem
 BOARD_AVB_BOOT_ALGORITHM := SHA256_RSA2048
-- 
2.55.0.windows.5

From 68fb9b12bec280eaf65e04f44f4d44b27c4bfdcd Mon Sep 17 00:00:00 2001
From: himanshuksr0007 <himanshuksr14@gmail.com>
Date: Tue, 15 Sep 2026 21:44:22 +0530
Subject: [PATCH] everpal: audio: disable ultrasound proximity, enable legacy
 spatializer param query

---
 configs/props/vendor.prop            | 5 ++++-
 sepolicy/vendor/hal_audio_default.te | 3 +++
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/configs/props/vendor.prop b/configs/props/vendor.prop
index f59ac35..2c7dafb 100644
--- a/configs/props/vendor.prop
+++ b/configs/props/vendor.prop
@@ -12,7 +12,8 @@ ro.config.media_vol_default=10
 ro.config.media_vol_steps=25
 ro.config.vc_call_vol_steps=11
 ro.vendor.audio.spk.stereo=true
-ro.vendor.audio.us.proximity=true
+# No ultrasound hardware on everpal; disable to prevent audioserver crash
+ro.vendor.audio.us.proximity=false
 ro.vendor.audio.vocal.support=true
 vendor.audiohal.telephonytx.type=2
 vendor.streamin.pcm.dump=0
@@ -28,6 +29,8 @@ persist.vendor.audio.spatializer.speaker_enabled=false
 # setting the effect-order hint prevents the EffectDownmix re-enter loop
 # that fires on every accdet (jack detect) state transition.
 ro.audio.spatializer.headtracking_supported=false
+# DecibelSpatializer HAL does not implement params 10/13; use legacy path
+ro.audio.spatializer.use_legacy_param_query=true
 
 # Bluetooth
 bluetooth.device.class_of_device=90,2,12
diff --git a/sepolicy/vendor/hal_audio_default.te b/sepolicy/vendor/hal_audio_default.te
index 3a9621d..7e2e797 100644
--- a/sepolicy/vendor/hal_audio_default.te
+++ b/sepolicy/vendor/hal_audio_default.te
@@ -1 +1,4 @@
 allow hal_audio_default persist_data_file:dir search;
+
+# Allow audioserver to read vendor default properties at startup
+get_prop(hal_audio_default, vendor_default_prop)
-- 
2.55.0.windows.5

