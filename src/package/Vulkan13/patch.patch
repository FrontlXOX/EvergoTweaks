# EverpalTweaks Vulkan 1.3 Production Patch
# Targets: device_xiaomi_everpal + vendor_xiaomi_everpal + android_kernel_xiaomi_mt6833
# Apply order: kernel → device → vendor
#
# Cherry-pick reference — apply each diff to the respective tree:
#   git -C src/trees/kernel apply <(sed -n '/^diff.*defconfig/,/^diff\|^$/p' src/package/Vulkan13/patch.patch)
#   git -C src/trees/device_xiaomi_everpal apply <(sed -n '/^diff.*device.mk\|^diff.*manifest\|^diff.*file_contexts/,/^diff\|^$/p' src/package/Vulkan13/patch.patch)
#   git -C src/trees/vendor_xiaomi_everpal apply <(sed -n '/^diff.*vendor.mk\|^diff.*Android.bp/,/^diff\|^$/p' src/package/Vulkan13/patch.patch)

# ===========================================================================
# 1. KERNEL: android_kernel_xiaomi_mt6833 (lineage-24.0)
# ===========================================================================

diff --git a/arch/arm64/configs/everpal_defconfig b/arch/arm64/configs/everpal_defconfig
--- a/arch/arm64/configs/everpal_defconfig
+++ b/arch/arm64/configs/everpal_defconfig
@@ -221,4 +221,4 @@ CONFIG_MTK_COMBO_CHIP_CONSYS_6833=y
 CONFIG_DRM_PANEL_XIAOMI_EVERPAL=y
 CONFIG_DRM_PANEL_XIAOMI_EVERPAL_TIANMA=y
 CONFIG_DRM_PANEL_XIAOMI_EVERPAL_CSOT=y
-CONFIG_MTK_GPU_VERSION="mali valhall r32p1"
+CONFIG_MTK_GPU_VERSION="mali valhall r44p0"

# ===========================================================================
# 2. DEVICE TREE: device_xiaomi_everpal (lineage-23.2)
# ===========================================================================

diff --git a/device.mk b/device.mk
--- a/device.mk
+++ b/device.mk
@@ -271,4 +271,4 @@ PRODUCT_COPY_FILES += \
     frameworks/native/data/etc/android.hardware.vulkan.compute-0.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.vulkan.compute.xml \
     frameworks/native/data/etc/android.hardware.vulkan.level-1.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.vulkan.level.xml \
-    frameworks/native/data/etc/android.hardware.vulkan.version-1_1.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.vulkan.version.xml \
+    frameworks/native/data/etc/android.hardware.vulkan.version-1_3.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.vulkan.version.xml \
+    frameworks/native/data/etc/android.software.vulkan.deqp.level-2023-03-01.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.software.vulkan.deqp.level.xml \
     frameworks/native/data/etc/android.software.opengles.deqp.level-2021-03-01.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.software.opengles.deqp.level.xml

diff --git a/configs/vintf/manifest.xml b/configs/vintf/manifest.xml
--- a/configs/vintf/manifest.xml
+++ b/configs/vintf/manifest.xml
@@ -154,3 +154,13 @@
     </hal>
+    <hal format="native" override="true">
+        <name>android.hardware.vulkan</name>
+        <version>1.3</version>
+        <interface>
+            <name>IVulkan</name>
+            <instance>passthrough/default</instance>
+        </interface>
+        <transport>passthrough</transport>
+    </hal>
 </manifest>

diff --git a/sepolicy/vendor/file_contexts b/sepolicy/vendor/file_contexts
--- a/sepolicy/vendor/file_contexts
+++ b/sepolicy/vendor/file_contexts
@@ -24,3 +24,6 @@
 # Graphics & Vulkan 1.3 SP-HAL companion libraries
 /(vendor|system/vendor)/lib(64)?/libge2\.so                                                                      u:object_r:same_process_hal_file:s0
 /(vendor|system/vendor)/lib(64)?/libgpd1\.so                                                                     u:object_r:same_process_hal_file:s0
+/(vendor|system/vendor)/lib(64)?/egl/libVK13_mali\.so                                                            u:object_r:same_process_hal_file:s0
+/(vendor|system/vendor)/lib(64)?/hw/vulkan\.mali\.so                                                             u:object_r:same_process_hal_file:s0
+/(vendor|system/vendor)/lib(64)?/hw/vulkan\.mt6833\.so                                                           u:object_r:same_process_hal_file:s0

# ===========================================================================
# 3. VENDOR TREE: vendor_xiaomi_everpal (lineage-23.2 / vulkan-1.3)
# ===========================================================================

diff --git a/everpal-vendor.mk b/everpal-vendor.mk
--- a/everpal-vendor.mk
+++ b/everpal-vendor.mk
@@ -340,3 +340,9 @@ PRODUCT_PACKAGES += \
     libGLES_mali \
+    libVK13_mali \
+    libge2 \
+    libgpd1 \
+    vulkan.mali \
+    vulkan.mt6833
+
+PRODUCT_COPY_FILES += \
+    vendor/xiaomi/everpal/proprietary/vendor/etc/mali_platform.config:$(TARGET_COPY_OUT_VENDOR)/etc/mali_platform.config

diff --git a/Android.bp b/Android.bp
--- a/Android.bp
+++ b/Android.bp
@@ -2900,3 +2900,63 @@
+cc_prebuilt_library_shared {
+    name: "vulkan.mali",
+    owner: "xiaomi",
+    strip: { none: true },
+    target: {
+        android_arm: { srcs: ["proprietary/vendor/lib/hw/vulkan.mali.so"], shared_libs: ["libc++", "libc", "libm", "libdl"] },
+        android_arm64: { srcs: ["proprietary/vendor/lib64/hw/vulkan.mali.so"], shared_libs: ["libc++", "libc", "libm", "libdl"] },
+    },
+    compile_multilib: "both",
+    relative_install_path: "hw",
+    symlinks: ["vulkan.mt6833.so"],
+    prefer: true,
+    soc_specific: true,
+}
+
+cc_prebuilt_library_shared {
+    name: "libVK13_mali",
+    owner: "xiaomi",
+    strip: { none: true },
+    target: {
+        android_arm: { srcs: ["proprietary/vendor/lib/egl/libVK13_mali.so"] },
+        android_arm64: { srcs: ["proprietary/vendor/lib64/egl/libVK13_mali.so"] },
+    },
+    compile_multilib: "both",
+    relative_install_path: "egl",
+    prefer: true,
+    soc_specific: true,
+}
+
+cc_prebuilt_library_shared {
+    name: "libgpd1",
+    owner: "xiaomi",
+    strip: { none: true },
+    target: {
+        android_arm: { srcs: ["proprietary/vendor/lib/libgpd1.so"] },
+        android_arm64: { srcs: ["proprietary/vendor/lib64/libgpd1.so"] },
+    },
+    compile_multilib: "both",
+    prefer: true,
+    soc_specific: true,
+}
+
+cc_prebuilt_library_shared {
+    name: "libge2",
+    owner: "xiaomi",
+    strip: { none: true },
+    target: {
+        android_arm: { srcs: ["proprietary/vendor/lib/libge2.so"] },
+        android_arm64: { srcs: ["proprietary/vendor/lib64/libge2.so"] },
+    },
+    compile_multilib: "both",
+    prefer: true,
+    soc_specific: true,
+}
