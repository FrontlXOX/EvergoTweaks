# ==============================================================================
# EverpalTweaks Vulkan 1.3 SELinux Policies (KernelSU / Magisk Runtime Only)
# ==============================================================================
# WARNING FOR ROM SOURCE TREE MAINTAINERS (Project Infinity / LineageOS):
# DO NOT copy or merge these rules into device_xiaomi_everpal source trees!
#
# 1. Why this file exists:
#    In KernelSU / Magisk root modules, MagicMount mounts files via OverlayFS
#    (dev="overlay"), which strips security labels down to generic 'vendor_file'
#    or 'unlabeled'. These rules inject runtime allowances via 'magiskpolicy'
#    so SurfaceFlinger and apps can read the overlay files without denials.
#
# 2. Why this is NOT needed in ROM trees:
#    When building the ROM from source, files are baked directly into /vendor
#    (ext4/erofs). Android file_contexts maps Vulkan HALs to 'same_process_hal_file'.
#    In AOSP Treble, SurfaceFlinger and appdomain ALREADY have built-in permissions
#    to execute same_process_hal_file.
#
# 3. CTS Neverallow Protection:
#    Pushing 'allow { coredomain appdomain } vendor_file:file execute' to ROM
#    source tree sepolicy will trigger CTS neverallow assertions during build.
# ==============================================================================

# Allow filesystem association on tmpfs for mirror-mounted vendor endpoints
allow same_process_hal_file tmpfs filesystem { associate }
allow vendor_configs_file tmpfs filesystem { associate }
allow vendor_file tmpfs filesystem { associate }

# SurfaceFlinger
allow surfaceflinger vendor_file file { read open getattr execute map }
allow surfaceflinger vendor_file dir { search read open getattr }
allow surfaceflinger vendor_file lnk_file { read getattr }
allow surfaceflinger same_process_hal_file file { read open getattr execute map }
allow surfaceflinger same_process_hal_file dir { search read open getattr }
allow surfaceflinger same_process_hal_file lnk_file { read getattr }
allow surfaceflinger vendor_configs_file file { read open getattr }
allow surfaceflinger vendor_configs_file dir { search read open getattr }
allow surfaceflinger magisk_file file { read open getattr execute map }
allow surfaceflinger magisk_file dir { search read open getattr }
allow surfaceflinger unlabeled file { read open getattr execute map }
allow surfaceflinger unlabeled dir { search read open getattr }
allow surfaceflinger labeledfs filesystem { associate }

# Appdomain (All User Apps, Games, Geekbench, 3DMark)
allow appdomain vendor_file file { read open getattr execute map }
allow appdomain vendor_file dir { search read open getattr }
allow appdomain vendor_file lnk_file { read getattr }
allow appdomain same_process_hal_file file { read open getattr execute map }
allow appdomain same_process_hal_file dir { search read open getattr }
allow appdomain same_process_hal_file lnk_file { read getattr }
allow appdomain vendor_configs_file file { read open getattr }
allow appdomain vendor_configs_file dir { search read open getattr }
allow appdomain magisk_file file { read open getattr execute map }
allow appdomain magisk_file dir { search read open getattr }
allow appdomain unlabeled file { read open getattr execute map }
allow appdomain unlabeled dir { search read open getattr }

# Graphics Allocators & Composers
allow hal_graphics_allocator_default vendor_file file { read open getattr execute map }
allow hal_graphics_allocator_default vendor_file dir { search read open getattr }
allow hal_graphics_allocator_default same_process_hal_file file { read open getattr execute map }
allow hal_graphics_allocator_default same_process_hal_file dir { search read open getattr }
allow hal_graphics_composer_default vendor_file file { read open getattr execute map }
allow hal_graphics_composer_default vendor_file dir { search read open getattr }
allow hal_graphics_composer_default same_process_hal_file file { read open getattr execute map }
allow hal_graphics_composer_default same_process_hal_file dir { search read open getattr }

# System Server & Boot Animation
allow system_server vendor_file file { read open getattr execute map }
allow system_server vendor_file dir { search read open getattr }
allow bootanim vendor_file file { read open getattr execute map }
allow bootanim vendor_file dir { search read open getattr }
allow bootanim same_process_hal_file file { read open getattr execute map }
