# ==============================================================================
# EverpalTweaks Vulkan 1.3 SELinux Policies (Hardened KernelSU / Magisk Runtime)
# ==============================================================================
# WARNING FOR ROM SOURCE TREE MAINTAINERS (Project Infinity / LineageOS):
# DO NOT copy or merge these rules into device_xiaomi_everpal source trees!
# In AOSP source trees, Treble CTS already grants necessary SP-HAL access.
# ==============================================================================

# Allow tmpfs filesystem association for mirror-mounted vendor endpoints
allow same_process_hal_file tmpfs filesystem { associate }
allow vendor_configs_file tmpfs filesystem { associate }
allow vendor_file tmpfs filesystem { associate }

# Grant SurfaceFlinger and Appdomain standard SP-HAL and config access
allow surfaceflinger same_process_hal_file file { read open getattr execute map }
allow surfaceflinger same_process_hal_file dir { search read open getattr }
allow surfaceflinger same_process_hal_file lnk_file { read getattr }
allow surfaceflinger vendor_configs_file file { read open getattr }
allow surfaceflinger vendor_configs_file dir { search read open getattr }
allow surfaceflinger vendor_file file { read open getattr }
allow surfaceflinger vendor_file dir { search read open getattr }

allow appdomain same_process_hal_file file { read open getattr execute map }
allow appdomain same_process_hal_file dir { search read open getattr }
allow appdomain same_process_hal_file lnk_file { read getattr }
allow appdomain vendor_configs_file file { read open getattr }
allow appdomain vendor_configs_file dir { search read open getattr }
allow appdomain vendor_file file { read open getattr }
allow appdomain vendor_file dir { search read open getattr }

# Graphics Allocators & Composers
allow hal_graphics_allocator_default same_process_hal_file file { read open getattr execute map }
allow hal_graphics_allocator_default same_process_hal_file dir { search read open getattr }
allow hal_graphics_composer_default same_process_hal_file file { read open getattr execute map }
allow hal_graphics_composer_default same_process_hal_file dir { search read open getattr }

# System Server & Boot Animation SP-HAL access
allow system_server same_process_hal_file file { read open getattr execute map }
allow system_server same_process_hal_file dir { search read open getattr }
allow bootanim same_process_hal_file file { read open getattr execute map }
allow bootanim same_process_hal_file dir { search read open getattr }
